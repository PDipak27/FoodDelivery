# Common environment variables shared across all service containers.
# Loaded automatically by Docker Compose from the same directory as the compose file.
# Do NOT commit real credentials — replace values before deploying outside localhost.

DB_USERNAME=postgres
DB_PASSWORD=postgres

REDIS_HOST=fd-redis
REDIS_PORT=6379

MAIL_HOST=fd-mailpit
MAIL_PORT=1025

MONGO_URI=mongodb://fd-mongodb:27017/fooddelivery_restaurant
